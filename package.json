{
  "name": "dsh-connect-loomy",
  "displayName": "DSH Connect Loomy",
  "description": "把本机登录的讯飞 Loomy 模型接入 DeepSeek Harness：复用桌面端登录态，提供模型目录、对话与积分查看。",
  "version": "0.1.0",
  "author": "txp2026txp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txp2026txp/dsh-connect-loomy.git"
  },
  "homepage": "https://github.com/txp2026txp/dsh-connect-loomy",
  "bugs": {
    "url": "https://github.com/txp2026txp/dsh-connect-loomy/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "loomy",
    "xunfei",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0 || >=1.0.0-0 <2.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
